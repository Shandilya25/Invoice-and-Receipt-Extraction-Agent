# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# In CI these come from GitHub Secrets; on Hugging Face Spaces from Space secrets.

LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# Home currency used when a receipt does not print one (flagged as inferred)
DEFAULT_CURRENCY=MYR
