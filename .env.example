# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# In CI these come from GitHub Secrets; on Hugging Face Spaces from the Space's secrets.

# Required: primary LLM (GPT-OSS-120B on Groq). Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional: fallback LLM (Gemini 3.1 Flash-Lite). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Home currency, used when a receipt prints no currency (flagged as CURRENCY_INFERRED)
DEFAULT_CURRENCY=MYR

# Optional tuning (defaults shown)
# LLM_PROVIDERS=groq,gemini     # order to try providers in
# LLM_TIMEOUT_S=30              # per LLM request
# LLM_MAX_RETRIES=2             # SDK retries on 429 / 5xx / timeouts, with backoff
# MAX_RECEIPT_AGE_DAYS=730      # older receipts go to review (0 disables the check)
# DB_PATH=data/app.db
# UPLOAD_DIR=uploads
# TRACE_FILE=traces/trace.jsonl
